<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Copy this file to Nosh/Secrets.plist and fill in your own values.
       Nosh/Secrets.plist is gitignored and must never be committed.

       Note: a bundled plist keeps keys out of git, but it still ships inside
       the app and can be extracted from the IPA. GEMINI_API_KEY should move
       behind a Cloud Function before release. -->
  <key>GEMINI_API_KEY</key>
  <string>YOUR_GEMINI_API_KEY</string>
  <key>CLOUDINARY_CLOUD_NAME</key>
  <string>YOUR_CLOUDINARY_CLOUD_NAME</string>
  <key>CLOUDINARY_UPLOAD_PRESET</key>
  <string>YOUR_UPLOAD_PRESET</string>
</dict>
</plist>
